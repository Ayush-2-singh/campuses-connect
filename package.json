{
  "name": "connect-to-campus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky",
    "cap:sync": "cap sync android",
    "cap:copy": "cap copy android",
    "cap:open": "cap open android",
    "android:debug": "cap sync android && cd android && ./gradlew assembleDebug",
    "android:bundle": "cap sync android && cd android && ./gradlew bundleRelease",
    "android:lint": "cap sync android && cd android && ./gradlew lint"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@livekit/components-react": "^2.9.24",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "@uiw/codemirror-theme-tokyo-night": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "framer-motion": "^14.6.0",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.0",
    "next": "15.5.28",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "unpdf": "^1.8.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.22",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "pg": "^8.23.0",
    "prettier": "^3.3.3",
    "supabase": "^2.111.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "comments": {
    "overrides": "Security pins. next 15.5.28 was installed for the critical Image-Optimization/ISR advisories; these three overrides lift the transitive high-severity packages it still pulls in (postcss 8.4.31, sharp 0.34.5, source-map-js 1.2.1). Remove an override once the parent ships a patched version."
  },
  "overrides": {
    "postcss": "^8.5.31",
    "sharp": "^0.35.5",
    "source-map-js": "^1.2.2"
  }
}
