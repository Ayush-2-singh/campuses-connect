<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Google sign-in returns here. Google blocks its consent screen
              inside embedded WebViews, so the flow runs in the system browser
              and comes back through this link:

                  connecttocampus://auth/callback?code=...

              Kept in sync with NATIVE_AUTH_CALLBACK in src/lib/native/oauth.ts.
              This same value must also be listed in Supabase under
              Authentication -> URL Configuration -> Redirect URLs.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="connecttocampus"
                    android:host="auth"
                    android:pathPrefix="/callback" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!--
          THE SCREEN MAY GO OFF, THE CALL MAY NOT.

          While a voice room is live, CallKeepAliveService runs as a foreground
          service: the process is exempt from the cached-app freezer, a wake
          lock keeps the CPU encoding/decoding, and the ongoing notification
          shows the call is still on. Without it, locking the phone freezes the
          WebView and the other person's voice simply stops.

          Types are declared for API 34+, which requires every <service> to name
          its type(s) and requires the matching install-time permission below.
        -->
        <service
            android:name=".CallKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Microphone — required for Live Voice Chat. The Capacitor WebView forwards
      getUserMedia({ audio }) as a WebView AUDIO_CAPTURE permission request,
      which Android can only grant when RECORD_AUDIO is declared here.
      Without it, joining any voice room fails to open audio.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      Background voice calls (see CallKeepAliveService above).

      FOREGROUND_SERVICE is the base right to run one at all;
      FOREGROUND_SERVICE_MICROPHONE / _MEDIA_PLAYBACK name the two types the
      service declares and are mandatory from Android 14 (targetSdk 34+) —
      without them the service crashes the moment it tries to start.
      WAKE_LOCK is what actually keeps the CPU awake with the screen off.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Camera / gallery access is intentionally NOT requested.

      @capacitor/camera uses the system camera intent (IMAGE_CAPTURE) and the
      Android photo picker (GET_CONTENT). Neither needs a runtime permission,
      and declaring android.permission.CAMERA would force an unnecessary prompt
      at the store-listing level. Files written for download/share go to the app
      cache, which also needs no permission, and is already exposed to Android's
      FileProvider via res/xml/file_paths.xml.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
