# Supabase — required for all environments (dev + Vercel)
# Get these from your Supabase project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# AI Brain — Gemini key (embeddings + answers + OCR). Required for /brain.
GEMINI_API_KEY=
# Optional: use Groq (llama-3.3-70b) for answers instead. Requires BRAIN_LLM=groq.
# GROQ_API_KEY=
# BRAIN_LLM=groq
